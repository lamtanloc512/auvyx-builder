{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "packages/*/src/**/*",
    "products/builder/blocks/**/*",
    "products/builder/editor/**/*",
    "products/builder/visual-builder/**/*",
    "tools/**/*",
    "types/**/*"
  ]
}
