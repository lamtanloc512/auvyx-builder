{
  "name": "@auvyx/builder",
  "version": "1.0.0",
  "private": true,
  "description": "Auvyx Builder WordPress plugin.",
  "scripts": {
    "build": "wp-scripts build --output-path=build && bun run generate",
    "start": "bun run generate && wp-scripts start --output-path=build",
    "generate": "wp-scripts build-blocks-manifest --input=blocks --output=generated/blocks-manifest.php && bun ../../tools/build-shared.ts && bun ../../tools/build-play.ts"
  },
  "dependencies": {
    "@auvyx/block-kit": "workspace:*",
    "@auvyx/block-ops": "workspace:*",
    "@auvyx/controls": "workspace:*",
    "@auvyx/shared": "workspace:*",
    "@auvyx/style-engine": "workspace:*",
    "@auvyx/visual-builder": "workspace:*",
    "@auvyx/play": "workspace:*"
  },
  "devDependencies": {
    "@wordpress/api-fetch": "^7.56.0",
    "@wordpress/block-editor": "*",
    "@wordpress/block-library": "^11.1.0",
    "@wordpress/blocks": "*",
    "@wordpress/components": "*",
    "@wordpress/compose": "*",
    "@wordpress/data": "*",
    "@wordpress/editor": "*",
    "@wordpress/element": "*",
    "@wordpress/i18n": "*",
    "@wordpress/icons": "*",
    "@wordpress/scripts": "^36.0.0"
  }
}
