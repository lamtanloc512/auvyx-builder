{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "auvyx/image",
  "title": "Auvyx Image",
  "category": "auvyx-builder",
  "description": "Image with responsive styles (size, radius, object-fit).",
  "keywords": ["picture", "photo", "media"],
  "textdomain": "auvyx-builder",
  "attributes": {
    "url": { "type": "string", "source": "attribute", "selector": "img", "attribute": "src" },
    "alt": { "type": "string", "source": "attribute", "selector": "img", "attribute": "alt", "default": "" },
    "href": { "type": "string", "source": "attribute", "selector": "a", "attribute": "href" },
    "id": { "type": "number" },
    "auvyx": { "type": "object" }
  },
  "usesContext": ["postId", "postType", "auvyx/item"],
  "supports": { "anchor": true, "html": false },
  "editorScript": "auvyx-builder-editor",
  "style": "auvyx-builder-blocks"
}
