  "interactions": {
    "recipes": [
      {
        "id": "auto",
        "label": "Automatic",
        "about": "What the block's kind gets: buttons press, linked pictures and icons respond, accordion headers respond, text links underline"
      },
      {
        "id": "button",
        "label": "Button",
        "about": "Background and border follow the pointer, presses in, keyboard focus ring; aria-pressed/aria-current show as selected, aria-disabled as disabled"
      },
      {
        "id": "link",
        "label": "Link",
        "about": "A quiet link: colour/underline (text) or a light change (picture, icon) on hover, focus ring"
      },
      {
        "id": "card",
        "label": "Card",
        "about": "A box people point at: lifts or outlines on hover, ring when something inside has keyboard focus. Use on boxes that hold one link or action"
      },
      {
        "id": "control",
        "label": "Form controls",
        "about": "Inputs, selects and text areas inside this box: hover border, focus ring, aria-invalid in the alert colour, disabled dimmed"
      },
      {
        "id": "disclosure",
        "label": "Disclosure",
        "about": "An accordion header: hover tint, focus ring, chevron turns when open"
      },
      {
        "id": "none",
        "label": "None",
        "about": "No interaction feedback (still a focus ring for keyboards: never removed)"
      }
    ],
    "variants": [
      {
        "id": "default",
        "label": "Default",
        "about": "Clear but quiet feedback"
      },
      {
        "id": "subtle",
        "label": "Subtle",
        "about": "Colour only: no movement, no shadow"
      },
      {
        "id": "expressive",
        "label": "Expressive",
        "about": "A little more: lift and shadow on hover, a deeper press"
      }
    ]
  },
