   ],
   "source": "<section class=\"auvyx-sf-sheet auvyx-sf-tone-dark auvyx-sf-layers\">{{#category.banner}}<div class=\"auvyx-sf-frame auvyx-sf-ratio-16-9 auvyx-sf-r-card auvyx-sf-clip\"><img src=\"{{category.banner.url}}\" alt=\"{{category.banner.alt}}\"></div>{{/category.banner}}<div class=\"auvyx-sf-stack auvyx-sf-gap-s auvyx-sf-p-m\"><h1 class=\"auvyx-sf-type-3xl\">{{category.title}}</h1>{{#category.intro}}<p>{{category.intro}}</p>{{/category.intro}}<span class=\"auvyx-sf-type-sm\">{{count}} products</span></div></section>",
   "context": "category",
   "html": "<section class=\"auvyx-sf-sheet auvyx-sf-tone-dark auvyx-sf-layers\"><div class=\"auvyx-sf-frame auvyx-sf-ratio-16-9 auvyx-sf-r-card auvyx-sf-clip\"><img src=\"https://shop.example/banner.webp\" alt=\"a&quot;b &amp; c\"></div><div class=\"auvyx-sf-stack auvyx-sf-gap-s auvyx-sf-p-m\"><h1 class=\"auvyx-sf-type-3xl\">Phones</h1><p>Điện thoại &amp; &lt;b&gt;not HTML&lt;/b&gt;</p><span class=\"auvyx-sf-type-sm\">7 products</span></div></section>"
  },
