    {"name": "a buyer's review waits for moderation", "action": "review.create", "as": "u1", "input": {"productId": {"$id": "pulse-buds"}, "stars": 4, "title": "Comfy", "body": "Good fit."},
     "expect": {"body": {"pending": true, "review": {"author": "Linh", "stars": 4, "title": "Comfy", "body": "Good fit.", "verified": true}}}},
    {"name": "reviews need an account", "action": "review.create", "input": {"productId": {"$id": "pulse-buds"}, "stars": 4, "title": "Comfy", "body": "Good fit."},
     "expect": {"status": 401, "code": "sign_in_required"}},
    {"name": "checkout from a cart", "action": "checkout.start", "as": "u1", "input": {}, "expect": {"body": {"url": "/checkout/shopping-cart"}}},
    {"name": "checkout with an empty cart", "action": "checkout.start", "input": {}, "expect": {"status": 409, "code": "conflict", "messageContains": "Your cart is empty"}},
    {"name": "track an order", "smoke": true, "action": "order.track", "input": {"code": "AUVYX-1001", "email": "linh@example.test"},
     "expect": {"bodyKeys": ["code", "status", "steps"], "body": {"code": "AUVYX-1001", "status": "confirmed", "steps": [{"step": "placed"}, {"step": "confirmed"}]}}},
    {"name": "the email is not case sensitive", "action": "order.track", "input": {"code": "AUVYX-1001", "email": "LINH@Example.test"}, "expect": {"body": {"status": "confirmed"}}},
    {"name": "a wrong email finds nothing", "smoke": true, "action": "order.track", "input": {"code": "AUVYX-1001", "email": "minh@example.test"},
     "expect": {"status": 404, "code": "not_found"}},
    {"name": "tracking is rate limited", "smoke": true, "action": "order.track", "repeat": 11, "input": {"code": "AUVYX-9999", "email": "x@example.test"},
     "expect": {"status": 429, "code": "rate_limited"}},
    {"name": "login", "action": "account.login", "input": {"login": "linh", "password": "test-password-1"}, "expect": {"bodyKeys": ["signedIn"], "body": {"signedIn": true}}},
    {"name": "login with a wrong password", "action": "account.login", "input": {"login": "linh", "password": "wrong-password"},
     "expect": {"status": 401, "code": "invalid_credentials"}},
    {"name": "register", "action": "account.register", "input": {"username": "newbie", "email": "newbie@example.test", "password": "test-password-3"},
     "expect": {"body": {"signedIn": true}}},
    {"name": "register a taken username", "action": "account.register", "input": {"username": "linh", "email": "other@example.test", "password": "test-password-3"},
     "expect": {"status": 409, "code": "conflict"}},
    {"name": "an unknown action names the nearest", "smoke": true, "action": "cart.ad", "input": {},
     "expect": {"status": 400, "code": "bad_request", "messageContains": "did you mean \"cart.add\""}}
  ]
}
