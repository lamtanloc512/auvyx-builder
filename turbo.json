{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../shared/**",
        "../../packages/*/src/**"
      ],
      "outputs": [
        "build/**",
        "generated/**",
        "assets/build/**"
      ]
    }
  }
}
